# Which handler loops run in this pod. Graph and retraction are specified, not built.
SKYDRA_ENABLED_HANDLERS=content,engagement
SKYDRA_JETSTREAM_URL=wss://jetstream2.us-east.bsky.network/subscribe
# Language code -> keywords. The keys double as the language filter.
SKYDRA_KEYWORDS={"en":["love"]}
# Engagement: alert when likes+reposts on one target reach the threshold within the window.
SKYDRA_ENGAGEMENT_WINDOW=60s
SKYDRA_ENGAGEMENT_THRESHOLD=100
# Bounded per-path queue size; a full queue drops the newest event.
SKYDRA_QUEUE_SIZE=1024
# How often the ingester logs per-path drop and discard counters.
SKYDRA_COUNTER_INTERVAL=10s
